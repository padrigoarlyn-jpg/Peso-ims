    # =========================================================
    # STANDARDIZED HTML ERROR PAGES
    # =========================================================
    # Explicit JSON responses from API/AJAX routes remain unchanged.
    # These handlers cover Flask/Werkzeug browser errors, including
    # Flask-Limiter's HTTP 429 response.

    @app.errorhandler(400)
    def bad_request(error):
        message = getattr(error, "description", None)
        default_description = (
            "The browser (or proxy) sent a request that this server "
            "could not understand."
        )
        if not message or message == default_description:
            message = None

        try:
            return render_template(
                "errors/400.html",
                error_message=message,
            ), 400
        except Exception:
            # Host validation may fail before Flask has a usable URL adapter.
            # Avoid request.host and request.path because they may raise too.
            app.logger.warning(
                "Unable to render HTTP 400 template for host=%r path=%r",
                request.environ.get("HTTP_HOST", "<unknown>"),
                request.environ.get("PATH_INFO", "/"),
                exc_info=True,
            )
            return Response(
                "400 Bad Request: The request could not be processed.\\n",
                status=400,
                mimetype="text/plain",
            )

    @app.errorhandler(403)
    def forbidden(error):
        return render_template("errors/403.html"), 403

    @app.errorhandler(404)
    def not_found(error):
        return render_template("errors/404.html"), 404

    @app.errorhandler(429)
    def too_many_requests(error):
        return render_template("errors/429.html"), 429

    @app.errorhandler(500)
    def internal_server_error(error):
        try:
            db.session.rollback()
        except Exception:
            app.logger.exception(
                "Unable to roll back database session after 500 error"
            )

        try:
            return render_template(
                "errors/500.html",
                error_message=(
                    "We could not complete your request right now. "
                    "Please try again later."
                ),
            ), 500
        except Exception:
            app.logger.exception("Unable to render HTTP 500 error template")
            return Response(
                "500 Internal Server Error: The request could not be completed.\\n",
                status=500,
                mimetype="text/plain",
            )

    return app
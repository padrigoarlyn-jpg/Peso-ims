# Add these to your existing .env; never upload actual .env to hosting repositories.
APP_ENV=production
SECRET_KEY=GENERATE_A_RANDOM_64_CHARACTER_SECRET
DATABASE_URL=mysql+pymysql://USER:PASSWORD@DBHOST/peso_ims
SESSION_COOKIE_SECURE=true
PUBLIC_BASE_URL=https://your-domain.example
TRUSTED_HOSTS=your-domain.example
ENABLE_SCHEDULER=false
BIND_HOST=127.0.0.1
PORT=5000
TRUSTED_PROXY=127.0.0.1
# Set mail credentials and QZ paths separately.
